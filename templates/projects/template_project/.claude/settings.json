{
  "permissions": {
    "allow": [
      "Bash(aw task *)",
      "Bash(aw decide *)",
      "Bash(aw log *)"
    ],
    "additionalDirectories": [
      "@@ROOT@@/agents",
      "@@ROOT@@/skills",
      "@@ROOT@@/tools"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "@@AW_CMD@@ hook session-start", "timeout": 15 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "@@AW_CMD@@ hook post-tool", "timeout": 10, "async": true }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          { "type": "command", "command": "@@AW_CMD@@ hook tool-failure", "timeout": 10, "async": true }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "@@AW_CMD@@ hook pre-compact", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "@@AW_CMD@@ hook stop", "timeout": 10 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "@@AW_CMD@@ hook session-end", "timeout": 15 }
        ]
      }
    ]
  }
}
